

# Discord webhook for alerts (Server Settings > Integrations > Webhooks)

# Safety switch: paper trading unless this is exactly "true"
LIVE_MODE=false

LOG_LEVEL=INFO


# 2026-06-23: loosened momentum 0.30->0.25 (backtest B: +22 trades/yr, E[R] +0.004->+0.020, win 46.9->50.8%, PF 1.11->1.20)
IOBOT_MOMENTUM_PCT=0.25

# --- TradingView webhook receiver (added 2026-06-24) ---
IOBOT_WEBHOOK_ENABLED=true
IOBOT_WEBHOOK_HOST=127.0.0.1

# ---- senior-trader pivot (2026-06-24): confluence TA scalper, $1k aggressive sleeve ----
IOBOT_SIGNAL=confluence
IOBOT_SLEEVE_CAPITAL=1000
# 2026-07-01: raised 300->500 (more of the higher-priced-name signals become tradeable).
# NOTE: effective ceiling = min(500, RISK_PCT% x sleeve equity); at equity ~$1651 the 30%
# risk cap (~$495) binds first, and floors at $300 if equity returns to $1000. Bump
# IOBOT_RISK_PCT to 50 to make a true $500 ceiling stick on the $1k base.
IOBOT_POSITION_MAX_DOLLARS=500
IOBOT_UNIVERSE=SPY,QQQ,AMD,AAPL,F,SOFI,PLTR,INTC,BAC,NIO,CCL,T,GOLD,XLF
IOBOT_RISK_PCT=30
# 2026-07-01: raised 2->3 (governor "max concurrent" was the #1 reject at 693/2102)
IOBOT_MAX_CONCURRENT=3
IOBOT_MAX_TRADES_DAY=10
IOBOT_MAX_ROUND_TRIPS=10
# 2026-06-26: post-close re-entry cooldown (min) on same symbol+direction — kills
# same-name churn (6/25: XLF +42 then -25, AAPL +361 then -180 on immediate re-entry).
IOBOT_SYMBOL_COOLDOWN_MIN=30
IOBOT_DAILY_MAX_LOSS_PCT=25
IOBOT_TRAILING_DD_PCT=40
IOBOT_ALLOW_OVERNIGHT=true
IOBOT_OVERNIGHT_MIN_DTE=1
IOBOT_MAX_HOLD_DAYS=5
IOBOT_CONFLUENCE_MIN=4

# ---- moderate selection loosening (2026-06-24): convert signals to fills on cheaper names ----
IOBOT_DELTA_MIN=0.50
IOBOT_DELTA_MAX=0.70
IOBOT_MAX_SPREAD_PCT=12
IOBOT_MIN_VOLUME=0
IOBOT_MIN_OI=100

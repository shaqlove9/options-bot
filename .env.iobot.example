# iobot — copy to .env (or .env.iobot) and fill. PAPER ONLY.
# A SEPARATE Alpaca paper account is recommended so this sleeve is isolated.
# Single-leg needs Level-2 options; the spread upgrade path needs Level 3.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
LOG_LEVEL=INFO

# --- universe / structure ---
IOBOT_UNIVERSE=SPY,QQQ
IOBOT_STRUCTURE=single          # single | spread
IOBOT_DELTA_MIN=0.60
IOBOT_DELTA_MAX=0.70
IOBOT_DTE_MIN=1
IOBOT_DTE_MAX=5
IOBOT_ALLOW_0DTE=false          # gamma/theta knife-edge — off by default
IOBOT_QTY=1

# --- debit-vertical upgrade (enable once equity supports the margin) ---
IOBOT_SPREAD_ENABLED=false
IOBOT_SPREAD_MIN_EQUITY=5000
IOBOT_SPREAD_MARGIN_BUFFER=1000
IOBOT_SPREAD_WIDTHS=1,2
IOBOT_SPREAD_TP_PCT=50

# --- entry signal (momentum) ---
IOBOT_MOMENTUM_PCT=0.30
IOBOT_RSI_PERIOD=5
IOBOT_RSI_CALL_MIN=60
IOBOT_RSI_PUT_MAX=40
IOBOT_REL_VOLUME_MIN=1.2
IOBOT_VWAP_FILTER=true

# --- session windows (ET) ---
IOBOT_ENTRY_START=09:45
IOBOT_ENTRY_END=15:30
IOBOT_FORCE_CLOSE=15:50
IOBOT_SCAN_INTERVAL=30

# --- exits (underlying-based) ---
IOBOT_STOP_PCT=0.40             # stop = % move of the UNDERLYING against entry
IOBOT_TARGET_R=1.5              # target = R x the risk distance

# --- liquidity filter ---
IOBOT_MAX_SPREAD_PCT=8
IOBOT_MIN_OI=250
IOBOT_MIN_VOLUME=50

# --- risk governor / kill switches ---
IOBOT_RISK_PCT=2                # per-trade max loss as % of equity (1-3)
IOBOT_DAILY_MAX_LOSS_PCT=5
IOBOT_TRAILING_DD_PCT=20
IOBOT_MAX_TRADES_DAY=6
IOBOT_MAX_CONCURRENT=1
IOBOT_MAX_ROUND_TRIPS=6
IOBOT_CASH_ACCOUNT=false        # one full-capital round-trip/day on settled funds

# --- validation gate ---
IOBOT_GATE_MIN_TRADES=40
IOBOT_FEE_PER_CONTRACT=0.65
IOBOT_SLIP_PER_LEG=0.02

# --- meta-labeling layer ---
IOBOT_META_MIN_TRADES=40
IOBOT_META_AUC_BAR=0.55
IOBOT_META_THRESHOLD=0.50
IOBOT_META_ACTIVE=false         # phase-3 single reversible flag (shadow until set)

# --- go-live (no live execution exists in this build) ---
IOBOT_GO_LIVE=false

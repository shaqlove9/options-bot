# .env.equity — config for the EQUITY-sleeve paper instance.
#   cp .env.equity.example .env.equity   then fill in a SEPARATE paper account's keys.
# .env.equity is gitignored (never commit real keys).
#
# Why a separate account: two main.py instances on ONE Alpaca account clash
# (mixed positions, reconcile() cancels all orders). Use a second paper account.
# The file-path overrides below keep this instance's status/stop/log/settings
# separate from the options bot so the dashboard and graceful-stop don't collide.

# --- SEPARATE Alpaca paper account (get keys at app.alpaca.markets, Paper) ---
ALPACA_API_KEY=YOUR_EQUITY_PAPER_KEY
ALPACA_SECRET_KEY=YOUR_EQUITY_PAPER_SECRET

# --- run the shares sleeve, paper only ---
INSTRUMENT=equity
LIVE_MODE=false

# --- isolate IPC/dashboard files from the options instance ---
STATUS_FILE=/home/ubuntu/options-bot/status_equity.json
STOP_FLAG_FILE=/home/ubuntu/options-bot/stop_equity.flag
BOT_LOG_FILE=/home/ubuntu/options-bot/bot_equity.log
CONSOLE_LOG_FILE=/home/ubuntu/options-bot/console_equity.log
SETTINGS_FILE=/home/ubuntu/options-bot/settings_equity.json

# --- optional: reuse the same Discord webhook, or set a different channel ---
# DISCORD_WEBHOOK_URL=
# AI_ENABLED=false

# .env.trend — ISOLATED paper account for the trend sleeve.
# Create a SEPARATE Alpaca paper account (or generate a fresh paper key pair) so
# the trend executor never collides with the options/equity sleeves, which share
# symbols (SPY/QQQ/IWM). Copy this to .env.trend and fill in the keys.
#
#   cp .env.trend.example .env.trend

ALPACA_API_KEY=your_trend_paper_key_here
ALPACA_SECRET_KEY=your_trend_paper_secret_here

# Keep it paper. The trend executor refuses to run under LIVE_MODE regardless.
LIVE_MODE=false

# Optional: a Discord webhook for trend alerts (falls back to .env if unset).
# DISCORD_WEBHOOK_URL=

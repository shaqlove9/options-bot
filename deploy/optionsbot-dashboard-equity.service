[Unit]
Description=Options Bot Dashboard — Equity Sleeve (Streamlit, monitoring only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/options-bot
# Monitoring only: hides Start/Stop so it can't fight the optionsbot-equity unit.
Environment=DASHBOARD_MONITOR_ONLY=true
# .env.equity supplies INSTRUMENT=equity + STATUS_FILE/SETTINGS_FILE/log overrides,
# so this dashboard reads the equity sleeve's status_equity.json and trades_equity.csv.
EnvironmentFile=/home/ubuntu/options-bot/.env.equity
# Bind to localhost only — reach it via SSH tunnel (-L 8502:localhost:8502).
ExecStart=/home/ubuntu/options-bot/.venv/bin/python -m streamlit run app.py \
  --server.address=127.0.0.1 \
  --server.port=8502 \
  --server.headless=true \
  --browser.gatherUsageStats=false
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

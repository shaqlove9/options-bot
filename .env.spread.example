# .env.spread — ISOLATED paper account for the defined-risk SPREAD sleeve.
#
# Requires a SEPARATE Alpaca PAPER account with LEVEL 3 OPTIONS approval — multi-leg
# (mleg) debit spreads need L3. Keep it isolated so it never collides with the equity
# or trend sleeves (they share symbols and would fight on a shared account).
#
#   cp .env.spread.example .env.spread     # then fill in the L3 paper account's keys

ALPACA_API_KEY=your_spread_l3_paper_key_here
ALPACA_SECRET_KEY=your_spread_l3_paper_secret_here

# Keep it paper. spread_bot.py refuses to run under LIVE_MODE regardless.
LIVE_MODE=false

# Optional: a Discord webhook for spread alerts (falls back to .env if unset).
# DISCORD_WEBHOOK_URL=

# Required — Alpaca API credentials (use paper keys first!)
# Get keys at: https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Set to true ONLY when you're ready for real money (also swap in live API keys)
LIVE_MODE=false

# Optional — Discord alerts (entry/exit/halt/daily summary)
# Create a webhook: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# Optional — AI analyst (pre-market briefings + end-of-day reports)
# Get a key at: https://platform.claude.com
ANTHROPIC_API_KEY=
AI_ENABLED=true

# Optional — logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional — set true on AWS/VM where systemd manages the bot
# Hides dashboard Start/Stop buttons to prevent conflicts
DASHBOARD_MONITOR_ONLY=false



# Discord webhook for alerts (Server Settings > Integrations > Webhooks)

# Safety switch: paper trading unless this is exactly "true"
LIVE_MODE=false

LOG_LEVEL=INFO


# 2026-06-23: loosened momentum 0.30->0.25 (backtest B: +22 trades/yr, E[R] +0.004->+0.020, win 46.9->50.8%, PF 1.11->1.20)
IOBOT_MOMENTUM_PCT=0.25

# --- TradingView webhook receiver (added 2026-06-24) ---
IOBOT_WEBHOOK_ENABLED=true
IOBOT_WEBHOOK_HOST=127.0.0.1

# ---- senior-trader pivot (2026-06-24): confluence TA scalper, $1k aggressive sleeve ----
IOBOT_SIGNAL=orb_confluence
# 2026-07-19: re-funded 1000->1551 so sleeve equity (= capital + realized PnL, now
# -$551) resets to exactly $1,000 — clean eval window for the 07-15 day-trade-only +
# no-midday config. At $449 equity the 50% risk cap ($224) rejected every contract
# (07-17: zero trades) and the 25% daily kill ($112) tripped on two ordinary stops.
# 2026-07-22: re-funded 1551->1932 (same clean-eval reset as 07-19): realized PnL is
# now -$932, so equity resets to exactly $1,000 for the orb_confluence eval window —
# at $619 the sleeve was $19 above the 40%-trailing kill and one stop would halt it.
IOBOT_SLEEVE_CAPITAL=1932
# 2026-07-01: raised 300->500 (more of the higher-priced-name signals become tradeable).
# NOTE: effective ceiling = min(500, RISK_PCT% x sleeve equity).
IOBOT_POSITION_MAX_DOLLARS=500
# 2026-07-22 strategy tightening ("better chance at winning", user-requested):
# signal -> orb_confluence = confluence + opening-range-breakout gate + stocks-in-play
# relvol >= 1.5 (Zarattini/Aziz ORB research; live book: winners 1.54x relvol vs
# losers 1.24x, relvol>=2 trades went 4/6 +$470). Universe drops the proven bleeders
# (SPY -675 0/5, QQQ -416, XLF -331, CCL -320, BAC -301, plus never-filled F/GOLD)
# and adds liquid high-beta movers (NVDA, TSLA, HOOD, MU) — the OI/spread/premium
# selection filters still auto-reject anything unsuitable.
IOBOT_UNIVERSE=AAPL,CSCO,T,INTC,GM
# 2026-07-22: entries start when the 30-min opening range is done + first bar closes;
# the 9:45 first-scan entries were opening-whipsaw bait (07-20 PLTR stopped in 2 min;
# 9:45-9:59 bucket n=17 net negative, 10:00-10:59 the only positive bucket). End 15:00
# so nothing new is bought 50 min before the 15:50 force-close (near-expiry time-stops
# were all losers).
IOBOT_ENTRY_START=10:15
IOBOT_ENTRY_END=15:00
# 2026-07-22: stop 1.2->1.5 ATR — 22 of 27 losses were underlying stops, avg loss
# bigger than avg win; 1.2x the 15m ATR sat inside ordinary noise (multiple sub-hour
# stop-outs). Target stays 1.8R.
IOBOT_ATR_STOP_MULT=1.5
# 2026-07-01 (later same day): 30->50 so the $500 position ceiling actually sticks —
# at 30% the risk cap bound first below ~$1,667 equity (6 "max loss > cap" rejects
# today at ~$463). At 50%, POSITION_MAX_DOLLARS=500 is the binding cap once sleeve
# equity >= $1,000; a worst-case single stop-out can now be up to half the sleeve.
IOBOT_RISK_PCT=50
# 2026-07-01: raised 2->3 (governor "max concurrent" was the #1 reject at 693/2102)
IOBOT_MAX_CONCURRENT=3
IOBOT_MAX_TRADES_DAY=10
IOBOT_MAX_ROUND_TRIPS=10
# 2026-06-26: post-close re-entry cooldown (min) on same symbol+direction — kills
# same-name churn (6/25: XLF +42 then -25, AAPL +361 then -180 on immediate re-entry).
IOBOT_SYMBOL_COOLDOWN_MIN=30
IOBOT_DAILY_MAX_LOSS_PCT=25
IOBOT_TRAILING_DD_PCT=40
# 2026-07-15: day-trade only — flat every position by FORCE_CLOSE (3:50pm ET), no
# overnight/weekend carry. The only two Fri->Mon holds (SPY -312, QQQ -416) gapped
# through their stops at the Mon 07-13 open and tripped the DD halt; weekend-gap risk
# is what we're removing here.
IOBOT_ALLOW_OVERNIGHT=false
IOBOT_OVERNIGHT_MIN_DTE=1
IOBOT_MAX_HOLD_DAYS=5
IOBOT_CONFLUENCE_MIN=4

# ---- moderate selection loosening (2026-06-24): convert signals to fills on cheaper names ----
IOBOT_DELTA_MIN=0.50
IOBOT_DELTA_MAX=0.70
IOBOT_MAX_SPREAD_PCT=12
IOBOT_MIN_VOLUME=0
IOBOT_MIN_OI=100

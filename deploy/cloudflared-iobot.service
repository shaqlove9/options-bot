# systemd unit for the iobot webhook Cloudflare Tunnel.
# Installed + enabled by deploy/setup-cloudflare-tunnel.sh.
# Runs as the ubuntu user with an explicit config so it survives reboots.
[Unit]
Description=cloudflared tunnel (iobot TradingView webhook)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --config /home/ubuntu/.cloudflared/config.yml run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
